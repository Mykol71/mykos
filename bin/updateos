#!/bin/bash

#Is root.
ID=$(/usr/bin/id -u)
[ $ID -ne 0 ] && echo "You must be root to run $0." && exit 1

#Init
VERSION="2.2.9"
LOG_FILE="/tmp/updateos.log"
export BACKEND="${MYKOS_UPDATEOS_BACKEND:-http://rhel8repo.centralus.cloudapp.azure.com/updateos}"
[ "`echo $#`" -ge "2" ] && export CMDLINEVARS="`echo $@ | cut -d" " -f2-`" || export CMDLINEVARS=""
export SCRIPT="$1"
export SUBGROUP="$1"
HELP="$2"
n="${10:-25}"
[ ! -d /usr/bin/.updateos ] &&  mkdir /usr/bin/.updateos

#OS Check.
for OSVERS in 7 8 9
  do
    [ "`grep " release $OSVERS." /etc/redhat-release`" != "" ] && export GROUP="rh$OSVERS"
  done

#Internet check.
nc -zw1 8.8.8.8 443 >/dev/null 2>&1
[ "$?" == "0" ] && NETUP=Y || NETUP=N

log() {
  echo "$@" && echo "$@" >> $LOG_FILE
  echo >> $LOG_FILE
}

directory_links() {
  LC_ALL=C sed -nE 's/.*<[aA][[:space:]]+[hH][rR][eE][fF]="([^"]+)".*/\1/p' |
    LC_ALL=C grep -E '^[A-Za-z0-9][A-Za-z0-9._-]*/?$'
}

usage() {
  SUBGROUP=""
    LGGRN='\033[1;32m'
    BLUE='\033[1;34m'
    NC='\033[0m'
    echo -e "${BLUE}@${NC}  updateos - $VERSION"
    printf ''${LGGRN}')~ '${NC}''
    echo "usage: sudo updateos (groupname|scriptname|help) [dry]"
    echo "$GROUP                       p desc"
    echo "---                       - ----"
  [ "$NETUP" == "Y" ] && SCRIPT_LIST=`/usr/bin/curl -ls $BACKEND/$GROUP/ | directory_links | grep -v \< | grep -v \/\/ | grep -v \? | grep -v ^/ | grep -v \/ | grep -v .md5 | grep -v nopub` || SCRIPT_LIST=`ls /usr/bin/.updateos/`
  for SCRIPT in $SCRIPT_LIST
    do
      download_script || exit $?
      DESC="`grep ^#DESC /usr/bin/.updateos/$SCRIPT | sed -e 's/^#DESC\ //g'`"
      [ "`grep ^#PRDno /usr/bin/.updateos/${SCRIPT} 2>/dev/null`" != "" ] && PRD="-" || PRD='^'
      SCRIPT="$SCRIPT$(printf '%*s' "$n" "")"        
      var="$(echo "${SCRIPT}"|grep -Eo "^.{1,$n}")" 
      echo -n " "
      printf '%s' "${var}" 
      echo -n ${PRD:0:58}
      echo -n " "
      echo ${DESC:0:70}
    done

#subgroup list
    [ "$NETUP" == "Y" ] && GROUP_LIST=`/usr/bin/curl -ls $BACKEND/$GROUP/ | directory_links | grep -v \< | grep -v \/\/ | grep -v \? | grep -v ^/ | grep \/ | grep -v .md5 | grep -v nopub`
    echo "group                     p desc"
    echo "-----                     - ----"
 for SUBGROUP in $GROUP_LIST
   do
      [ "`curl -s $BACKEND/$GROUP/$SUBGROUP/README.md | grep ^#PRDno`" == "" ] && PRD="^" || PRD='-'
      DESC="`curl -s $BACKEND/$GROUP/$SUBGROUP/README.md | grep ^#DESC | sed -e 's/^#DESC\ //g'`" 
      SUBGROUP="`echo $SUBGROUP | cut -d/ -f1`"
      SUBGROUP="$SUBGROUP$(printf '%*s' "$n" "")"        
      var="$(echo "${SUBGROUP}"|grep -Eo "^.{1,$n}")" 
      echo -n " "
      printf '%s' "${var}" 
      echo -n ${PRD:0:58}
      echo -n " "
      echo ${DESC:0:70}
   done
exit 0
}

run_subgroup() {
    [ "$NETUP" != "Y" ] && log "Internet down. No subgroups without internet." && return 0
    [ "`echo $HELP | grep -i dry`" != "" ] || [ "`echo $HELP | grep -i help`" != "" ] && HELP="`curl -s $BACKEND/$GROUP/$SUBGROUP/README.md | grep ^#HELP | sed -e 's/^#HELP\ //g'`" && echo "$HELP" && echo && /usr/bin/curl -ls $BACKEND/$GROUP/$file | grep -v $file | directory_links | grep -v \< | grep -v \/\/ | grep -v \? | grep -v ^/ | grep -v \/ | grep -v .md5 | grep -v README.md && exit $EXIT
    [ "`echo $HELP`" != "" ] && log "updateos - $VERSION - USAGE: sudo updateos (groupname|scriptname|help) [dry]" && exit 0 
    local listing scripts
    listing=$(/usr/bin/curl --fail --location --silent --show-error --connect-timeout 15 --max-time 120 "$BACKEND/$GROUP/$file") || { log "Could not read subgroup $GROUP/$SUBGROUP; no subgroup was completed."; exit 1; }
    scripts=$(printf '%s\n' "$listing" | directory_links | grep -v / | grep -v '[.]md5$' | grep -v '^README[.]md$')
    [ -n "$scripts" ] || { log "No scripts found for $GROUP/$SUBGROUP; no subgroup was completed."; exit 1; }
    for SCRIPT in $scripts 
  do
      log "----> `date` - Running $GROUP $SUBGROUP $SCRIPT..."
      download_script || exit $?
      [ "`echo $SCRIPT | grep crypt`" != "" ] && openssl enc -d -aes-256-cbc -pbkdf2 -in /usr/bin/.updateos/$SCRIPT -out /usr/bin/.updateos/`echo $SCRIPT | cut -d"_" -f1-3`
      SCRIPT="`echo $SCRIPT | cut -d"_" -f1-3`"
      chmod +x /usr/bin/.updateos/$SCRIPT
      if [ "${MYKOS_UPDATEOS_STRICT:-0}" = 1 ] && head -n 1 "/usr/bin/.updateos/$SCRIPT" | grep -qE '^#!.*/(env +)?(ba)?sh([[:space:]]|$)'; then
        /bin/bash -e "/usr/bin/.updateos/$SCRIPT" 2>&1 | tee -a "$LOG_FILE"
        EXIT="${PIPESTATUS[0]}"
      else
        /usr/bin/.updateos/${SCRIPT} 2>&1 | tee -a "$LOG_FILE"
        EXIT="${PIPESTATUS[0]}"
      fi
      [ "$EXIT" != "0" ] && log "Failed." && exit $EXIT
      log "----> `date` - Success."
    done
exit $EXIT
}

run_script() {
  SUBGROUP=""
  download_script || exit $?
  [ "`echo $HELP | grep -i dry`" != "" ] && cat /usr/bin/.updateos/${SCRIPT} && exit $EXIT
      [ "`echo $SCRIPT | grep crypt`" != "" ] && openssl enc -d -aes-256-cbc -pbkdf2 -in /usr/bin/.updateos/$SCRIPT -out /usr/bin/.updateos/`echo $SCRIPT | cut -d"_" -f1-3`
      SCRIPT="`echo $SCRIPT | cut -d"_" -f1-3`"
      chmod +x /usr/bin/.updateos/$SCRIPT
  log "----> `date` -  Running $SCRIPT ..."
  [ "`grep ^#PRDno /usr/bin/.updateos/${SCRIPT}`" != "" ] && echo -n "Script not labelled as prod ready. Contine? y/n " && read YN && [ "$YN" != "y" ] && exit $EXIT
  /usr/bin/.updateos/${SCRIPT} $CMDLINEVARS 2>&1 | tee -a $LOG_FILE
  EXIT="${PIPESTATUS[0]}"
  [ "`echo $SCRIPT | grep _enc`" != "" ] && rm -f /usr/bin/.updateos/$SCRIPT
  [ "$EXIT" != "0" ] && log "Failed." && exit $EXIT
  log "----> `date` - Success." && exit $EXIT
}

script_help() {
  echo "`cat /usr/bin/.updateos/$SCRIPT | grep ^#HELP /usr/bin/.updateos/$SCRIPT | sed -e 's/^#HELP\ //g'`"
exit 0
}

download_script () {
  [ "$NETUP" != "Y" ] && return 0
  case "$SCRIPT" in ''|*[!A-Za-z0-9._-]*) log "Invalid script name: $SCRIPT"; return 2 ;; esac
  case "$SUBGROUP" in *[!A-Za-z0-9._-]*) log "Invalid subgroup name"; return 2 ;; esac
  local url="$BACKEND/$GROUP/${SUBGROUP:+$SUBGROUP/}$SCRIPT"
  local expected actual temporary
  expected=$(/usr/bin/curl --fail --location --silent "$url.md5" 2>/dev/null) || expected=""
  actual=$(md5sum "/usr/bin/.updateos/$SCRIPT" 2>/dev/null | cut -d" " -f1)
  if [[ "$expected" =~ ^[[:xdigit:]]{32}$ ]] && [ "$expected" = "$actual" ]; then return 0; fi
  temporary=$(mktemp "/usr/bin/.updateos/.${SCRIPT}.XXXXXX") || return 1
  if ! /usr/bin/curl --fail --location --silent --show-error "$url" -o "$temporary"; then
    rm -f "$temporary"
    log "Could not download $GROUP/${SUBGROUP:+$SUBGROUP/}$SCRIPT; no script was executed."
    return 1
  fi
  if [ ! -s "$temporary" ] || head -c 512 "$temporary" | grep -qiE '<!doctype[[:space:]]+html|<html([[:space:]>])'; then
    rm -f "$temporary"; log "Rejected empty or HTML response for $SCRIPT"; return 1
  fi
  if [[ "$expected" =~ ^[[:xdigit:]]{32}$ ]] && [ "$(md5sum "$temporary" | cut -d" " -f1)" != "$expected" ]; then
    rm -f "$temporary"; log "Checksum mismatch for $SCRIPT"; return 1
  fi
  chmod +x "$temporary" && mv -f "$temporary" "/usr/bin/.updateos/$SCRIPT" || { rm -f "$temporary"; return 1; }
}

# main
  [ "$#" == "0" ] || [ "`echo $1 | grep -i help 2>/dev/null`" != "" ] && usage
  [ "$NETUP" == "Y" ] && SCRIPT_LIST=`/usr/bin/curl -ls $BACKEND/$GROUP/ | directory_links | grep -v \< | grep -v \/\/ | grep -v \? | grep -v ^/ | grep -v .md5 | grep -v nopub | grep $SCRIPT` || SCRIPT_LIST=`ls /usr/bin/.updateos/ | grep $SCRIPT`
  for file in $SCRIPT_LIST
  do
    [ "`echo $file | grep \/`" != "" ] && run_subgroup
    [ "`echo $CMDLINEVARS | grep -i help`" != "" ] && script_help
    [ "`echo $file | grep -v \/`" != "" ] && run_script
  done 
     [ "${MYKOS_UPDATEOS_STRICT:-0}" != 1 ] || { log "Requested update group/script was not found; image staging was not completed."; exit 1; }
     log "updateos - $VERSION - USAGE: sudo updateos (groupname|scriptname|help) [dry]"
     rm -f /usr/bin/.updateos/$SCRIPT
exit 0
