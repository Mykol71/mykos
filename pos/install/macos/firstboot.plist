<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dockur.macos.firstboot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/macos-unattended/firstboot.sh</string>
    </array>
    <key>KeepAlive</key>
    <dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardErrorPath</key><string>/var/log/macos-unattended-firstboot-stderr.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
