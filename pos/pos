}

prune-docker() {
  /usr/local/sbin/mykos-prune purge || return $?
  unset SHOPCODE CONTAINER POSTYPE

}

update_meraki() {
(
[ -n "$MERAKI_API_KEY" ] && [ -n "$MERAKI_ORG_ID" ] && [ -n "${VPN_PSK:-}" ] || { echo "Configure Meraki credentials in /etc/mykos/pos.env and enter the VPN PSK during setup"; exit 1; }
[[ "$MERAKI_ORG_ID" =~ ^[0-9]+$ ]] || { echo "Invalid Meraki organization ID"; exit 1; }
[[ ! "$MERAKI_API_KEY" =~ [[:cntrl:]] ]] || { echo "Invalid Meraki API key"; exit 1; }
local work endpoint
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/mykos-meraki.XXXXXXXX") || exit 1
trap 'rm -rf -- "$work"' EXIT
printf 'Authorization: Bearer %s\nAccept: application/json\n' "$MERAKI_API_KEY" > "$work/headers" || exit 1
endpoint="https://api.meraki.com/api/v1/organizations/$MERAKI_ORG_ID/appliance/vpn/thirdPartyVPNPeers"
echo "Downloading existing Meraki site-to-site peers...."
curl --fail --silent --show-error --connect-timeout 15 --max-time 60 \
  --request GET --url "$endpoint" --header "@$work/headers" --output "$work/existing.json" || exit 1
"$MYKOS_PYTHON" - "$work/existing.json" <<'VALIDATE_PY' || exit 1
import json,sys
try:
 v=json.load(open(sys.argv[1]))
 if not isinstance(v,dict) or not isinstance(v.get('peers'),list) or not all(isinstance(p,dict) for p in v['peers']):raise ValueError()
except (ValueError,OSError):raise SystemExit('Cannot read existing Meraki peers; configuration was not changed')
VALIDATE_PY
# Resolve the remote MX to one network in this organization; never fall back to all networks.
local next_url page=0 selected_network
next_url="https://api.meraki.com/api/v1/organizations/$MERAKI_ORG_ID/appliance/uplink/statuses?perPage=1000"
while [ -n "$next_url" ]; do
  page=$((page+1)); [ "$page" -le 100 ] || { echo 'Too many Meraki inventory pages'; exit 1; }
  curl --fail --silent --show-error --connect-timeout 15 --max-time 60 --request GET \
    --url "$next_url" --header "@$work/headers" --dump-header "$work/page.headers" --output "$work/sites-$page.json" || exit 1
  next_url=$("$MYKOS_PYTHON" - "$work/page.headers" "$MERAKI_ORG_ID" <<'PAGE_PY'
import re,sys,urllib.parse
text=open(sys.argv[1]).read()
links=re.findall(r'<([^>]+)>;\s*rel="?next"?',text,re.I)
if len(links)>1:raise SystemExit('Ambiguous Meraki pagination')
if links:
 u=urllib.parse.urlsplit(links[0])
 if u.scheme!='https' or u.netloc!='api.meraki.com' or u.path!='/api/v1/organizations/'+sys.argv[2]+'/appliance/uplink/statuses':
  raise SystemExit('Unexpected Meraki pagination URL')
 print(links[0])
PAGE_PY
) || exit 1
done
selected_network=$("$MYKOS_PYTHON" - "$work" "$REMOTE_PUBLIC" <<'SITE_PY'
import ipaddress,json,pathlib,socket,sys
try:
 addresses={a[4][0] for a in socket.getaddrinfo(sys.argv[2],None,socket.AF_INET)}
 rows=[]
 for p in pathlib.Path(sys.argv[1]).glob('sites-*.json'):
  value=json.loads(p.read_text())
  if not isinstance(value,list) or not all(isinstance(x,dict) for x in value):raise ValueError()
  rows+=value
 matches={r['networkId'] for r in rows if isinstance(r.get('networkId'),str) and any(u.get('publicIp') in addresses or u.get('ip') in addresses for u in r.get('uplinks',[]) if isinstance(u,dict))}
 if len(matches)!=1:raise ValueError()
 print(next(iter(matches)))
except (OSError,ValueError,KeyError):
 raise SystemExit('Could not uniquely match the remote Meraki site in this organization; no VPN peers were changed')
SITE_PY
) || exit 1
# Preserve the complete downloaded peer list. Never PUT an empty fallback on GET/JSON failure.
MERAKI_ROUTE_BASED="${VPN_ROUTE_BASED:-0}" VPN_PSK="$VPN_PSK" REMOTE_NAME="$REMOTE_NAME" VPN_LOCAL_CIDR="$VPN_LOCAL_CIDR" PUBLIC="$PUBLIC" MERAKI_NETWORK_ID="$selected_network" MERAKI_PEER_NAME="${SHOPCODE:+$SHOPCODE.}$REMOTE_NAME" VPN_LOCAL_ID="${VPN_LOCAL_ID:-192.168.222.0}" VPN_REMOTE_ID="${VPN_REMOTE_ID:-192.168.222.0}" "$MYKOS_PYTHON" - "$work/existing.json" "$work/payload.json" <<'JSON_PY'
import json, os, sys
try:
    with open(sys.argv[1]) as handle: current=json.load(handle)
    if not isinstance(current,dict) or not isinstance(current.get('peers'),list) or not all(isinstance(p,dict) for p in current['peers']):
        raise ValueError()
except (ValueError,OSError):
    raise SystemExit('Cannot read existing Meraki peers; configuration was not changed')
peer = {
    "name": os.environ["MERAKI_PEER_NAME"],
    "ikeVersion": "2", "secret": os.environ["VPN_PSK"],
    "privateSubnets": [os.environ["VPN_LOCAL_CIDR"]],
    "ipsecPolicies": {"ikeCipherAlgo": ["aes128"], "ikeAuthAlgo": ["sha1"],
        "ikePrfAlgo": ["prfsha1"], "ikeDiffieHellmanGroup": ["group21"], "ikeLifetime": 28800,
        "childCipherAlgo": ["aes128", "aes192", "aes256", "tripledes"],
        "childAuthAlgo": ["sha256", "sha1", "md5"], "childPfsGroup": ["disabled"], "childLifetime": 28800},
    "networkTags": ["none"], "localId": os.environ["VPN_REMOTE_ID"], "remoteId": os.environ["VPN_LOCAL_ID"],
    "isRouteBased": os.environ["MERAKI_ROUTE_BASED"]=="1", "publicIp": os.environ["PUBLIC"],
    "network": {"ids": [os.environ["MERAKI_NETWORK_ID"]]}}
matches=[p for p in current['peers'] if p.get('name')==peer['name']]
if matches:
    if len(matches)==1 and all(matches[0].get(k)==v for k,v in peer.items()):
        raise SystemExit(3)
    raise SystemExit('A Meraki peer already uses this name with different settings; configuration was not changed')
with open(sys.argv[2],'w') as handle:
    json.dump({'peers':current['peers']+[peer]},handle)
JSON_PY
local merge_status=$?
if [ "$merge_status" = 3 ]; then echo "Meraki peer already configured; no changes needed."; exit 0; fi
[ "$merge_status" = 0 ] || exit "$merge_status"
# Refuse to overwrite edits made while the user was choosing a remote site.
curl --fail --silent --show-error --connect-timeout 15 --max-time 60 --request GET \
  --url "$endpoint" --header "@$work/headers" --output "$work/recheck.json" || exit 1
"$MYKOS_PYTHON" - "$work/existing.json" "$work/recheck.json" <<'RECHECK_PY' || exit 1
import json,sys
try:
 if json.load(open(sys.argv[1]))!=json.load(open(sys.argv[2])):raise ValueError()
except (OSError,ValueError):raise SystemExit('Meraki peers changed during setup; nothing was uploaded. Review and retry.')
RECHECK_PY
echo "Appending site-to-site peer on Meraki...."
curl --fail --silent --show-error --connect-timeout 15 --max-time 60 --request PUT \
  --url "$endpoint" --header "@$work/headers" \
  --header 'Content-Type: application/json' --data-binary "@$work/payload.json" --output "$work/result.json" || exit 1
# A successful HTTP code alone does not verify the returned configuration.
"$MYKOS_PYTHON" - "$work/payload.json" "$work/result.json" <<'VERIFY_PY' || exit 1
import json,sys
def subset(expected,actual):
 if isinstance(expected,dict):return isinstance(actual,dict) and all(k=='secret' or (k in actual and subset(v,actual[k])) for k,v in expected.items())
 return expected==actual
try:
 requested=json.load(open(sys.argv[1]))['peers'];returned=json.load(open(sys.argv[2]))['peers']
 if not isinstance(returned,list) or len(requested)!=len(returned):raise ValueError()
 remaining=list(returned)
 for peer in requested:
  match=next((i for i,value in enumerate(remaining) if subset(peer,value)),None)
  if match is None:raise ValueError()
  remaining.pop(match)
except (OSError,ValueError,KeyError,TypeError):
 raise SystemExit('Meraki reply could not be verified; local VPN remains unchanged. Check Dashboard before retrying.')
VERIFY_PY
echo "Done.... Existing peers retained."
)
}

list_vpns() {
  if [ "$CONTAINER" != "" ]; then
    /usr/local/sbin/mykos-linux vpn "$SHOPCODE"
  fi
}

add_vpn() {
local VPN_PSK vpn_psk_escaped host_connection VPN_LOCAL_CIDR VPN_LOCAL_ID VPN_REMOTE_ID VPN_MODE=direct VPN_REMOTE_CIDR VPN_ROUTE_BASED=0
VPN_LOCAL_CIDR=192.168.222.0/24
if [ "${MYKOS_VPN_HOST:-0}" != 1 ]; then
[[ "${SHOPCODE:-}" =~ ^[0-9]{8}$ ]] || { echo "Invalid ID"; return 1; }
[ -z "${CONTAINER:-}" ] && { echo "No running container......"; return 1; }

fi
# gather user input
INPUTS="REMOTE_NAME REMOTE_PUBLIC REMOTE_NET"
for var in $INPUTS; do
  echo -n "Enter $var: "
  read -r REPLY
  export "$var=$REPLY"
done
# Names become filenames and connection names; reject traversal and config injection.
[[ "$REMOTE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || { echo "Invalid remote name"; return 1; }
[[ "$REMOTE_PUBLIC" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] || { echo "Invalid remote public IP or hostname"; return 1; }
VPN_REMOTE_CIDR=$("$MYKOS_PYTHON" -c 'import ipaddress,sys;v=sys.argv[1];print(ipaddress.IPv4Network(v if "/" in v else v+"/24",strict=True))' "$REMOTE_NET") || return 1
if [ "${MYKOS_VPN_HOST:-0}" != 1 ]; then
  read -r -p 'VPN mode: direct guest tunnel [1], gateway for all MYKOS guests [2]: ' VPN_MODE || return 1
  case "$VPN_MODE" in ''|1|direct) VPN_MODE=direct ;; 2|gateway) VPN_MODE=gateway ;; *) echo 'Choose 1 or 2'; return 1 ;; esac
else
  read -r -p 'Host VPN mode: host only [1], shared gateway for all guests and host [2]: ' VPN_MODE || return 1
  case "$VPN_MODE" in ''|1|direct) VPN_MODE=direct ;; 2|gateway) VPN_MODE=host-gateway ;; *) echo 'Choose 1 or 2'; return 1 ;; esac
fi
VPN_LOCAL_ID=192.168.222.0; VPN_REMOTE_ID=192.168.222.0
if [ "${MYKOS_VPN_HOST:-0}" != 1 ]; then
  VPN_LOCAL_ID="$SHOPCODE.$(hostname)"; VPN_REMOTE_ID="$REMOTE_PUBLIC"
elif [ "$VPN_MODE" = host-gateway ]; then
  VPN_LOCAL_ID="$(hostname)"; VPN_REMOTE_ID="$REMOTE_PUBLIC"
fi
if [ "${MYKOS_VPN_HOST:-0}" != 1 ] || [ "$VPN_MODE" = host-gateway ]; then VPN_ROUTE_BASED=1; fi
read -r -s -p "Enter VPN shared secret (PSK): " VPN_PSK || { echo; return 1; }
echo
[ -n "$VPN_PSK" ] || { echo "VPN shared secret cannot be empty"; return 1; }
[[ ! "$VPN_PSK" =~ [[:cntrl:]] ]] || { echo "VPN shared secret must be a single line"; return 1; }
# Escape quotes/backslashes for the quoted ipsec.secrets value.
vpn_psk_escaped=$(printf '%s' "$VPN_PSK" | sed 's/[\\"]/\\&/g')
#set public ip
PUBLIC=$(curl --fail --silent --show-error --connect-timeout 15 --max-time 20 https://ifconfig.me) || return 1
PUBLIC=$("$MYKOS_PYTHON" -c 'import ipaddress,sys;print(ipaddress.IPv4Address(sys.argv[1].strip()))' "$PUBLIC") || return 1
[ "${MYKOS_VPN_HOST:-0}" = 1 ] || IP=$(/usr/local/sbin/mykos-linux ip "$SHOPCODE")
#setup vpn-data vol
if [ "${MYKOS_VPN_HOST:-0}" = 1 ]; then
  [ -e "/etc/ipsec.d/mykos-$REMOTE_NAME.conn.conf" ] && { echo "VPN connection already exists."; return 1; }
else
[[ ! -L ".$SHOPCODE" ]] || { echo "VPN directory must not be a symlink"; return 1; }
[[ ! -L ".$SHOPCODE/ipsec.secrets" ]] || { echo "VPN secrets must not be a symlink"; return 1; }
# check if vpn exist
[ -f ".$SHOPCODE/$REMOTE_NAME.conn.conf" ] && { echo "VPN connection already exists."; return 1; }
fi
# verify input
if [ "$INPUTS" != "" ]; then
  echo "ipsec VPN Connection about to be created:"
  echo "--------------------"
  echo "Continue y/n?"
  read -r -p "" || return 1
  if [[ "$REPLY" != "y" && "$REPLY" != "Y" ]]; then
    return
  else
    echo "Validating VPN Connection......"
# Resolve/validate all local selectors before any optional remote update.
if [ "${MYKOS_VPN_HOST:-0}" != 1 ]; then
local vpn_ip
vpn_ip="$IP"
VPN_LOCAL_CIDR=$("$MYKOS_PYTHON" -c 'import ipaddress,sys;print(str(ipaddress.IPv4Address(sys.argv[1]))+"/32")' "$vpn_ip") || return 1
if [ "$VPN_MODE" = gateway ]; then
  VPN_LOCAL_CIDR=$("$MYKOS_PYTHON" -c 'import sys;sys.path.insert(0,"/usr/local/sbin");from mykos_network import address_pool;from mykos_runtime import config;print(address_pool(config()))') || return 1
fi
fi
if [ "$VPN_MODE" = host-gateway ]; then
  VPN_LOCAL_CIDR=$("$MYKOS_PYTHON" -c 'import sys;sys.path.insert(0,"/usr/local/sbin");from mykos_network import address_pool;from mykos_runtime import config;print(address_pool(config()))') || return 1
fi
# Read-only dependency/mount preflight must precede any remote peer update.
if [ "${MYKOS_VPN_HOST:-0}" != 1 ]; then
  /usr/local/sbin/mykos-linux vpn-preflight "$SHOPCODE" >/dev/null || return 1
fi
local check_mode=direct check_owner="${SHOPCODE:-host}" check_connection="$REMOTE_NAME"
case "$VPN_MODE" in gateway|host-gateway) check_mode=shared ;; esac
if [ "${MYKOS_VPN_HOST:-0}" = 1 ]; then check_owner=host;check_connection="mykos-$REMOTE_NAME";fi
/usr/local/sbin/mykos-vpn-gateway preflight "$check_owner" "$check_connection" "$check_mode" >/dev/null || return 1
# A failed selected upload is a no-op locally. No directory, config, secret,
# service or routing mutation occurs before this success gate.
    echo -n "Push peer config to meraki? y/n " && read -r ans || return 1
    case "$ans" in
      y|Y) update_meraki || return 1 ;;
      n|N|'') ;;
      *) echo 'Choose y or n'; return 1 ;;
    esac
echo "Creating VPN Connection......"
# make connection ipsec config file
if [ "${MYKOS_VPN_HOST:-0}" = 1 ]; then
  if [ "$VPN_MODE" = host-gateway ]; then
    host_connection=$(printf '%s\0' "$REMOTE_NAME" "$REMOTE_PUBLIC" "$VPN_LOCAL_CIDR" "$VPN_REMOTE_CIDR" "$VPN_PSK" "$VPN_LOCAL_ID" "$VPN_REMOTE_ID" | "$MYKOS_PYTHON" ./host-vpn --save-host-shared) || return 1
  else
  host_connection=$(printf '%s\0' "$REMOTE_NAME" "$REMOTE_PUBLIC" "$REMOTE_NET" "$VPN_PSK" | "$MYKOS_PYTHON" ./host-vpn --save) || return 1
  fi
else
mkdir -p -- ".$SHOPCODE" || return 1
printf '%s\0' "$SHOPCODE" "$REMOTE_NAME" "$REMOTE_PUBLIC" "$VPN_LOCAL_CIDR" "$VPN_REMOTE_CIDR" "$VPN_PSK" "$VPN_LOCAL_ID" "$VPN_REMOTE_ID" | "$MYKOS_PYTHON" ./host-vpn --save-native || return 1

fi
    if [ "${MYKOS_VPN_HOST:-0}" = 1 ]; then
      if [ "$VPN_MODE" = host-gateway ]; then systemctl start ipsec || return 1; fi
      /usr/sbin/ipsec auto --rereadsecrets || return 1
      /usr/sbin/ipsec auto --add "$host_connection" || return 1
      /usr/sbin/ipsec auto --up "$host_connection" || return 1
      if [ "$VPN_MODE" = host-gateway ]; then
        /usr/local/sbin/mykos-vpn-gateway configure-host "$host_connection" "$VPN_REMOTE_CIDR" || return 1
      fi
    else
      /usr/local/sbin/mykos-linux prepare-vpn "$SHOPCODE" || return 1
      podman exec "$CONTAINER" systemctl start ipsec || return 1
      vpn_peer=$(cat ".$SHOPCODE/$REMOTE_NAME.vpn-peer") || return 1
      podman exec "$CONTAINER" "/etc/ipsec.d/$REMOTE_NAME.updown" --allow-peer "$vpn_peer" || return 1
      podman exec "$CONTAINER" ipsec auto --rereadsecrets || return 1
      podman exec "$CONTAINER" ipsec auto --add "$REMOTE_NAME" || return 1
      podman exec "$CONTAINER" ipsec auto --asynchronous --up "$REMOTE_NAME" || return 1
      if [ "$VPN_MODE" = gateway ]; then
        /usr/local/sbin/mykos-vpn-gateway configure "$SHOPCODE" "$REMOTE_NAME" "$VPN_REMOTE_CIDR" || return 1
      fi
    fi
    echo "VPN Connection info..." && echo
    echo "Remote-side VPN Info:"
    echo "Cisco/Meraki Dash --> Security --> Site-to-site VPN --> IPsec VPN Peers --> Add a peer" && echo
    echo "Name: $REMOTE_NAME"
    echo "IKE Version: IKEv2"
    echo "Public IP or Hostname: $PUBLIC"
    echo "Local ID: $VPN_REMOTE_ID"
    echo "Remote ID: $VPN_LOCAL_ID"
    echo "Shared Secret: (entered during setup)"
    echo "Static Routing"
    echo "Private Subnets: $VPN_LOCAL_CIDR"
    echo "Availability: Selected remote Meraki site only"
    echo "IPsec Policy: Custom"
    echo "Phase 1 Encryption: AES128"
    echo "Authentication: SHA1"
    echo "Psuedo-random function: SHA1"
    echo "Diffie-Hellman group: 21"
    echo "Lifetime: 28800"
    echo "Phase 2 Encryption: AES128"
    echo "Authenticaion: SHA1"
    echo "PFS group: Off"
    echo "Lifetime: 28800" 
  fi
else
  echo "Nothing to do."
fi
}

rm_vpn() {
[[ "$SHOPCODE" =~ ^[0-9]{8}$ ]] || { echo 'Invalid ID'; return 1; }
[[ "$CONTAINER" =~ ^[0-9]{8}(\.[A-Za-z0-9_.-]+)?$ && "${CONTAINER:0:8}" = "$SHOPCODE" ]] || { echo 'Invalid container'; return 1; }
local directory=".$SHOPCODE" path CONN found=0
[ -d "$directory" ] && [ ! -L "$directory" ] || { echo 'No connections.'; return 1; }
for path in "$directory"/*.conn.conf; do
  [ -f "$path" ] && [ ! -L "$path" ] || continue
  path=${path##*/};printf '%s\n' "${path%.conn.conf}";found=1
done
[ "$found" = 1 ] || { echo 'No connections.'; return; }
read -r -p 'Connection to stop and remove: ' CONN || return 1
[[ "$CONN" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || { echo 'Invalid connection'; return 1; }
path="$directory/$CONN.conn.conf"
[ -f "$path" ] && [ ! -L "$path" ] || { echo 'Select a listed connection'; return 1; }
local confirmation
read -r -p "Type $CONN to confirm removal: " confirmation || return 1
[ "$confirmation" = "$CONN" ] || { echo 'Cancelled'; return 1; }
# Use the existing text-admin workflow: remove the selected configuration and reload IPsec.
/usr/local/sbin/mykos-vpn-gateway remove "$SHOPCODE" "$CONN" || return 1
if [ -f "$directory/$CONN.updown" ] && [ ! -L "$directory/$CONN.updown" ]; then
  podman exec "$CONTAINER" "/etc/ipsec.d/$CONN.updown" --remove "$CONN" || return 1
fi
podman exec "$CONTAINER" ipsec auto --delete "$CONN" || return 1
rm -f -- "$path" "$directory/$CONN.secrets" "$directory/$CONN.updown" "$directory/$CONN.default.conf" "$directory/$CONN.vpn-peer" || return 1
podman exec "$CONTAINER" ipsec auto --rereadsecrets || return 1
echo "Removed VPN $CONN"
}

clear_vpns() {
[ -f .$SHOPCODE.container ] && echo "Running container. Stop it first....." && return 
[ ! -d .$SHOPCDE ] && echo "No VPNs configured......" && return
echo "About to wipe all connections for $SHOPCODE."
echo "Continue y/n?" && read -p ""
[ "$REPLY" == "y" ] && [ "$REPLY" != "" ] && rm -rf .$SHOPCODE
}



