#!/usr/bin/bash

#DESC

###
#ENV
###

VERSION="1.7"
OSB=rh
MAJOR=8
OS=$OSB$MAJOR
HOSTNAME=$(hostname)
# Use the RPM runtime on RHEL 8 instead of its older system python3.
if [ -x /usr/bin/python3.9 ]; then MYKOS_PYTHON=/usr/bin/python3.9; else MYKOS_PYTHON=python3; fi
[ -f /etc/mykos/pos.env ] && . /etc/mykos/pos.env
REPOSERVER=${REPOSERVER:-mykol.com}
NETDEV=$(ip route get 8.8.8.8 | awk -- '{printf $5}')
MERAKI_API_KEY=${MERAKI_API_KEY:-}
MERAKI_ORG_ID=${MERAKI_ORG_ID:-}
# Only the fixed host entry point selects host VPN setup.
MYKOS_VPN_HOST=0
BUILDDATE=$(date +%Y%m%d)
BUILDROOT=/var/tmp/containers/$BUILDDATE/$KSNAME
mkdir -p $BUILDROOT/docker
HOST_USER=`whoami`
#[ "$HOST_USER" != "root" ] && echo "You must be root or in sudoers to run $0." && exit 1
export ROOTDIR="$(pwd)"
[ -f .shopcode ] && SHOPCODE="`cat .shopcode`"
[ -f .$SHOPCODE.container ] && CONTAINER=`cat .$SHOPCODE.container`
[ -f .container ] && CONTAINER=`cat .container`
LGGRN='\033[1;32m'
BLUE='\033[1;34m'
TEAL='\033[38;5;31m'
GREY='\033[0;37m'
NC='\033[0m'


###
#FUNCS
###

check_image_builder() {
  case "$OS" in
    rh10|rocky8|rocky9|rocky10|alma8|alma9|alma10|oracle8|oracle9|oracle10|centos8|centos9|centos10|fedora43|fedora44)
      command -v ksvalidator >/dev/null 2>&1 || { echo 'Install pykickstart on the builder.' >&2; return 1; }
      # Validate the temporary copy with the installed parser, independent of host release.
      create_ks || return 1
      ksvalidator "/var/tmp/$OS.ks" || return 1 ;;
  esac
}

create_ks() {
"$MYKOS_PYTHON" ./prepare_ks.py "ks/$OS.ks" "/var/tmp/$OS.ks"
}

create_dockerfile() {
local os_version os_vendor update_step update_tmp
case "$OS" in
  rocky*) os_vendor='Rocky Linux'; update_step= ;;
  alma*) os_vendor='AlmaLinux'; update_step= ;;
  oracle*) os_vendor='Oracle Linux'; update_step= ;;
  centos*) os_vendor='CentOS Stream'; update_step= ;;
  fedora*) os_vendor='Fedora'; update_step= ;;
  *) os_vendor=RHEL
     # Fetch and validate on the builder; minimal guests need no download client.
     update_tmp=$(mktemp .mykos-updateos.XXXXXX) || return 1
     if ! curl --fail --show-error --location --retry 2 --connect-timeout 15 --max-time 120 "${MYKOS_REPO_ORIGIN:-https://$REPOSERVER}/updateos/updateos" -o "$update_tmp" ||
        ! test -s "$update_tmp" || ! bash -n "$update_tmp"; then
       rm -f -- "$update_tmp"
       echo 'Could not stage the updateos script; Podman build was not started.' >&2
       return 1
     fi
     if ! chmod 0755 "$update_tmp" || ! mv -f -- "$update_tmp" updateos; then
       rm -f -- "$update_tmp"
       return 1
     fi
     update_step='COPY updateos /usr/bin/updateos' ;;
esac
os_version=$("$MYKOS_PYTHON" "$ROOTDIR/image_version.py" "$OS-docker.tar.xz") || return 1
cat << EOF > Dockerfile
FROM scratch
ADD $OS-docker.tar.xz /
LABEL io.mykos.os="$OS"
LABEL io.mykos.os.version="$os_version"
LABEL org.label-schema.schema-version="1.0" \
    org.label-schema.name="$OS Base Image" \
    org.label-schema.vendor="$os_vendor" \
    org.label-schema.license="GPLv2" \
    org.label-schema.build-date="20261003"
MAINTAINER “Mike Green" <mgreen@teleflora.com>
ENV container $OS-docker
VOLUME /sys/fs/cgroup
$update_step
CMD ["/usr/bin/bash"]
EOF
}

stop_container() {
  if "$MYKOS_PYTHON" ./vm info "$SHOPCODE" >/dev/null 2>&1; then
    "$MYKOS_PYTHON" ./vm stop "$SHOPCODE"
    return $?
  fi
  /usr/local/sbin/mykos-linux stop "$SHOPCODE"

}

stage_image() {
  SHOPCODE=$(cat .shopcode) && POSTYPE=$(cat .$SHOPCODE.postype) && OS=$(cat .$SHOPCODE.imagetype)
  case "$OS" in win*|wns*|mac*|ubuntu*) "$MYKOS_PYTHON" ./vm start "$SHOPCODE" "$OS"; return $? ;; esac
  if podman container exists "$SHOPCODE.$(hostname)"; then
    /usr/local/sbin/mykos-linux start "$SHOPCODE"
    return $?
  fi
  restore=no
  if [ "$("$MYKOS_PYTHON" -c 'import sys; sys.path.insert(0,"/usr/local/sbin"); import mykos_profiles; print(mykos_profiles.has_backup(sys.argv[1]))' "$SHOPCODE")" = True ]; then
    read -r -p 'Use the configured application backup? (y/n): ' ans
    [ "$ans" = y ] && restore=yes
  fi
  /usr/local/sbin/mykos-stage-pos "$SHOPCODE" "$restore" "$OS" || return $?
  CONTAINER=$(cat ".$SHOPCODE.container")
  IP=$(/usr/local/sbin/mykos-linux ip "$SHOPCODE")

}

create-image() {
  local image_selection
  printf '%s\n' \
    'OS choices:' \
    '  All EL images   all' \
    '  RedHat          rh7 rh8 rh9 rh10' \
    '  Rocky Linux     rocky8 rocky9 rocky10' \
    '  AlmaLinux       alma8 alma9 alma10' \
    '  Oracle Linux    oracle8 oracle9 oracle10' \
    '  CentOS Stream   centos8 centos9 centos10' \
    '  Fedora          fedora43 fedora44' \
    '  Windows         win11 win10 win8e win7u winxp winme win2k win98' \
    '  Windows Server  wns2025 wns2022 wns2019 wns2016' \
    '  macOS           mac15 mac14 mac13 mac12' \
    '  Ubuntu          ubuntu20.04 ubuntu22.04 ubuntu24.04' \
    '  SQL Server      mssql2025 mssql2022' && printf 'OS: ' && read -r image_selection || return 1
  if [ "$image_selection" = all ]; then
    build-all-images
  else
    OS="$image_selection"
    build-image "$OS"
  fi
}

build-image() (
  local OS="$1"
  case "$OS" in
    win*|wns*|mac*|ubuntu*)
      renice -n 1 -p "$BASHPID" >/dev/null || return 1
      "$MYKOS_PYTHON" ./vm create "$OS"; return $? ;;
  esac
  case "$OS" in rh7|rh8|rh9|rh10|oracle8|oracle9|oracle10|centos8|centos9|centos10|fedora43|fedora44|rocky8|rocky9|rocky10|alma8|alma9|alma10|mssql2025|mssql2022) ;; *) echo 'Invalid OS selection' >&2; return 1 ;; esac
  renice -n 1 -p "$BASHPID" >/dev/null || return 1
  if podman image exists "$OS"; then echo "Image already built: $OS"; return 0; fi
  check_image_builder || return 1
  rm -f "/var/tmp/$OS-docker.tar.xz" || return 1
  create_ks || return 1
  if ! "$MYKOS_PYTHON" ./build_rootfs.py "$OS" "/var/tmp/$OS.ks"; then
    echo "Image creation failed; see the installer diagnostics directory printed above. Podman build was not started." >&2
    return 1
  fi
  [ -s "/var/tmp/$OS-docker.tar.xz" ] || { echo 'Image creator did not produce a rootfs archive' >&2; return 1; }
  mkdir -p "$BUILDROOT/docker" || return 1
  mv "/var/tmp/$OS-docker.tar.xz" "$BUILDROOT/docker" || return 1
  (
    cd "$BUILDROOT/docker" || exit 1
    create_dockerfile && podman build --tag "$OS" .
  ) || return 1
  CONTAINER=$(/usr/local/sbin/mykos-native-image-start "$OS") || return 1
  podman exec "$CONTAINER" /bin/sh -c 'if [ -f /etc/yum/pluginconf.d/subscription-manager.conf ]; then sed -i "s/enabled=1/enabled=0/g" /etc/yum/pluginconf.d/subscription-manager.conf; fi' || return 1
  podman exec "$CONTAINER" systemctl restart sshd || return 1
  podman commit "$CONTAINER" "$OS:latest"
)

build-all-images() {
  local image completed=0
  local images=(rh7 rh8 rh9 rh10 rocky8 rocky9 rocky10 alma8 alma9 alma10 oracle8 oracle9 oracle10 centos8 centos9 centos10)
  for image in "${images[@]}"; do
    printf '\n[%s/%s] Build EL image: %s\n' "$((completed+1))" "${#images[@]}" "$image"
    if build-image "$image"; then
      completed=$((completed+1))
    else
      printf 'Build stopped at %s; remaining images were not started.\n' "$image" >&2
      printf 'Built or reused: %s/%s\n' "$completed" "${#images[@]}" >&2
      return 1
    fi
  done
  printf '\nAll EL images built or reused: %s/%s\n' "$completed" "${#images[@]}"
}

