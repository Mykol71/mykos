# LAN clients get the private download link; direct requests remain protected.
<Directory "/var/www/mykos-repository-root">
    <If "-R '127.0.0.1/32' || -R '::1/128' || -R '192.168.222.0/24' || -R '192.168.22.0/24'">
        DirectoryIndex index-lan.html index.html
    </If>
    <Else>
        DirectoryIndex index.html
    </Else>
    <Files "index-lan.html">
        AuthMerging Off
        Require ip 127.0.0.1 ::1 192.168.222.0/24 192.168.22.0/24
    </Files>
</Directory>
