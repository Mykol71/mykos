#!/bin/bash
set -euo pipefail
checkpoint=/storage/.mykos-checkpoint
if [[ ${MYKOS_ANDROID_INSTALL:-N} == Y ]]; then
    python3 /run/mykos-android-media
    # The legacy ISO needs an optical controller: generic hybrid detection
    # selects USB, which SeaBIOS cannot boot through this xHCI profile.
    python3 - <<'MYKOS_ANDROID_OPTICAL'
from pathlib import Path
path=Path('/run/disk.sh')
text=path.read_text()
original='if [[ "$hybrid" != "0000" ]]; then'
patched='if [[ "$hybrid" != "0000" && "${MYKOS_ANDROID_INSTALL:-N}" != Y ]]; then'
if text.count(original)==1:
    path.write_text(text.replace(original,patched,1))
elif text.count(patched)!=1:
    raise SystemExit('Unsupported Android installer media controller profile')
MYKOS_ANDROID_OPTICAL
    export BOOT=/storage/boot.iso
fi
# MYKOS MACOS AUTOMATIC BOOT
# A fresh runtime wrapper must retain unattended boot after installer devices leave.
if [[ -f /assets/config.plist ]]; then
    python3 - <<'MYKOS_MAC_BOOT'
import plistlib
from pathlib import Path
path=Path('/assets/config.plist')
value=plistlib.loads(path.read_bytes())
value['Misc']['Boot'].update(Timeout=2,ShowPicker=False)
path.write_bytes(plistlib.dumps(value))
MYKOS_MAC_BOOT
fi
# END MYKOS MACOS AUTOMATIC BOOT
# Customize the vendor answer asset while retaining its media-specific XML
# generation, drivers, QGA and SetupComplete/first-logon scripts.
if [[ ${MYKOS_UNATTENDED:-} == windows ]]; then
    [[ ${MYKOS_WINDOWS_ASSET:-} =~ ^win[0-9a-z-]+$ ]] || exit 1
    asset=/run/assets/$MYKOS_WINDOWS_ASSET.xml
    [[ -f "$asset" && -s /run/mykos-autounattend.xml ]] || exit 1
    [[ -f /run/.mykos-original-answer.xml ]] || cp "$asset" /run/.mykos-original-answer.xml
    cp /run/mykos-autounattend.xml "$asset"
fi
# A staged Windows disk must never re-enter Dockur's installation cleanup.
# Keep captured setup media too: RAM restore needs the same QEMU devices.
if [[ ${MYKOS_PRESERVE_WINDOWS_DISK:-N} == Y ]]; then
    [[ -s /storage/data.img || -s /storage/data.qcow2 ]] || { echo 'Missing staged Windows disk; refusing installation' >&2; exit 1; }
    [[ -f /run/install.sh ]] || { echo 'Unsupported Windows startup script' >&2; exit 1; }
    for function in needsInstall cleanupTemp cleanupSource; do
        grep -q "^${function}() {" /run/install.sh || { echo "Unsupported Windows startup: $function" >&2; exit 1; }
    done
    rewrite=$(mktemp /run/.mykos-install.XXXXXX)
    awk '
        $0 ~ /^  \[\[ \$\{MYKOS_PRESERVE_WINDOWS_DISK:-N\} == Y \]\] \&\& return [01]$/ { next }
        { print }
        /^needsInstall\(\) \{/ { print "  [[ ${MYKOS_PRESERVE_WINDOWS_DISK:-N} == Y ]] && return 1" }
        /^cleanupTemp\(\) \{|^cleanupSource\(\) \{/ { print "  [[ ${MYKOS_PRESERVE_WINDOWS_DISK:-N} == Y ]] && return 0" }
    ' /run/install.sh > "$rewrite"
    cat "$rewrite" > /run/install.sh
    rm -f "$rewrite"
fi
# Runtime entry.sh edits live in the wrapper's persistent writable layer.
# Clear our previous one-shot hook before deciding whether this boot restores RAM.
if [[ -f /run/entry.sh ]]; then
    rewrite=$(mktemp /run/.mykos-entry.XXXXXX)
    awk '$0 != " . /run/mykos-checkpoint-restore" {gsub(/Restoring checkpoint for /,"Booting "); print}' /run/entry.sh > "$rewrite"
    cat "$rewrite" > /run/entry.sh
    rm -f "$rewrite"
fi
# Vendor startup may initialize firewall rules and perform host-side checks.
# Install isolation after that setup and before QEMU can start any guest CPU.
if [[ ${MYKOS_NETWORK_ISOLATED:-0} == 1 ]]; then
    grep -q '^\. finish.sh' /run/entry.sh || { echo 'Unsupported isolated VM entry script' >&2; exit 1; }
    cat > /run/mykos-peer-isolation <<'ISOLATE'
for command in iptables ip6tables; do
    "$command" -w 5 -N MYKOS_COPY_OUT 2>/dev/null || "$command" -w 5 -F MYKOS_COPY_OUT
    "$command" -w 5 -A MYKOS_COPY_OUT -o lo -j ACCEPT
    "$command" -w 5 -A MYKOS_COPY_OUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    "$command" -w 5 -A MYKOS_COPY_OUT -j REJECT
    "$command" -w 5 -I FORWARD 1 -j DROP
    "$command" -w 5 -I OUTPUT 1 -j MYKOS_COPY_OUT
done
ISOLATE
    rewrite=$(mktemp /run/.mykos-isolate.XXXXXX)
    awk '$0 == " . /run/mykos-peer-isolation" {next} /^\. finish.sh/ {print; print " . /run/mykos-peer-isolation"; next} {print}' /run/entry.sh > "$rewrite"
    cat "$rewrite" > /run/entry.sh; rm -f "$rewrite"
fi
if [[ -f "$checkpoint/restore.request" ]]; then
    [[ -f "$checkpoint/memory.gz" && ! -L "$checkpoint/memory.gz" ]] || { echo 'Missing VM memory checkpoint' >&2; exit 1; }
    grep -q '^\. finish.sh' /run/entry.sh || { echo 'Unsupported VM entry script' >&2; exit 1; }
    cat > /run/mykos-checkpoint-load <<'LOAD'
#!/bin/bash
set -euo pipefail
exec gzip -dc /storage/.mykos-checkpoint/memory.gz
LOAD
    chmod 0700 /run/mykos-checkpoint-load
    cat > /run/mykos-checkpoint-restore <<'RESTORE'
# Loaded after the image has constructed its complete QEMU arguments.
ARGS+=" -incoming exec:/run/mykos-checkpoint-load -S"
waitForBoot() { return 0; }
RESTORE
    rewrite=$(mktemp /run/.mykos-entry.XXXXXX)
    awk '/^\. finish.sh/ {print; print " . /run/mykos-checkpoint-restore"; next} {gsub(/Booting /,"Restoring checkpoint for "); print}' /run/entry.sh > "$rewrite"
    cat "$rewrite" > /run/entry.sh
    rm -f "$rewrite"
    # One-shot restore: later container starts boot its current disks normally.
    mv "$checkpoint/restore.request" "$checkpoint/restore.consumed"
fi
# QEMU and its vCPU/I/O threads inherit the image builder's CPU priority.
if [[ ${MYKOS_BUILD_NICE:-0} == 1 ]]; then
    renice -n 15 -p "$$" >/dev/null || echo 'Warning: Image build CPU priority could not be set' >&2
    ionice -c 2 -n 7 -p "$$" >/dev/null || echo 'Warning: Image build disk priority could not be set' >&2
fi
if [[ ${MYKOS_UNATTENDED:-} == ubuntu || ${MYKOS_UNATTENDED:-} == fedora || ${MYKOS_UNATTENDED:-} == macos ]]; then
    exec /run/mykos-unattended-entry
fi
exec /run/entry.sh
