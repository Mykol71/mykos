#!/usr/bin/env python3
"""Initialize, collect, or run a private MYKOS scheduled command."""
import os
import sys
from mykos_commands import init,collect,work
if os.geteuid()!=0: raise SystemExit('Root required')
if sys.argv[1:]==['init']: init()
elif sys.argv[1:]==['collect']: collect()
elif len(sys.argv)==3 and sys.argv[1]=='run': work(sys.argv[2])
else: raise SystemExit('Usage: mykos-command init|collect|run ID')
