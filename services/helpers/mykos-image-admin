#!/usr/bin/env python3
import argparse,json
from mykos_image_admin import worker
p=argparse.ArgumentParser(description='MYKOS prepared image removal worker')
p.add_argument('os');p.add_argument('--worker',action='store_true',required=True)
a=p.parse_args()
try:print(json.dumps(worker(a.os)))
except (ValueError,RuntimeError,OSError) as e:p.exit(1,str(e)+'\n')
