#!/usr/bin/env python3
import argparse,json
from mykos_image_build import build, worker, status
p=argparse.ArgumentParser(description='Build or resume an OS image while preserving its source image.')
p.add_argument('os');p.add_argument('--replace',action='store_true');p.add_argument('--worker',action='store_true');p.add_argument('--status',action='store_true')
p.add_argument('--ram-mib',type=int,help='Guest RAM in MiB; EL VM profiles accept 256 MiB increments')
a=p.parse_args()
if a.ram_mib is not None and (a.status or a.worker):p.error('--ram-mib applies to a new or explicitly resumed build, not --status/--worker')
try:print(json.dumps(status(a.os) if a.status else worker(a.os) if a.worker else build(a.os,replace=a.replace,**({'ram_mib':a.ram_mib} if a.ram_mib is not None else {})),indent=2))
except (ValueError,RuntimeError,OSError) as e:p.exit(1,str(e)+'\n')
