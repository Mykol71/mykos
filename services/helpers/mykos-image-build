#!/usr/bin/env python3
import argparse,json
from mykos_image_build import build, worker, status
p=argparse.ArgumentParser(description='Unattended image build; creates no helper containers.')
p.add_argument('os');p.add_argument('--replace',action='store_true');p.add_argument('--worker',action='store_true');p.add_argument('--status',action='store_true')
a=p.parse_args()
try:print(json.dumps(status(a.os) if a.status else worker(a.os) if a.worker else build(a.os,replace=a.replace),indent=2))
except (ValueError,RuntimeError,OSError) as e:p.exit(1,str(e)+'\n')
