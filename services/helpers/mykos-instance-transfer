#!/opt/mykos-web/.venv/bin/python
"""Root worker, invoked only with a journal identifier by the admin helper."""
import sys
import json
from mykos_instance_transfer import worker, housekeeping, guarded_source_recovery, dispatch
if sys.argv[1:] == ['dispatch']:
    try:
        result = dispatch(json.load(sys.stdin))
        print(json.dumps({'ok': True, 'result': result}))
    except Exception as error:
        print(json.dumps({'ok': False, 'error': str(error)[:1000]}))
        raise SystemExit(1)
    raise SystemExit(0)
if sys.argv[1:] == ['cleanup']:
    housekeeping()
    raise SystemExit(0)
if len(sys.argv) == 3 and sys.argv[1] == 'recover-source':
    guarded_source_recovery(sys.argv[2])
    raise SystemExit(0)
if len(sys.argv) != 3 or sys.argv[1] != 'worker':
    raise SystemExit('Expected worker and transfer identifier')
worker(sys.argv[2])
