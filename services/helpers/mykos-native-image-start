#!/usr/bin/env python3
"""Start a newly built native OS image on the configured managed network."""
import sys
import re
import mykos_vm as vm
from mykos_runtime import config, run, PODMAN, NATIVE_OS_NAMES, build_priority
from mykos_network import native_arguments as arguments
from mykos_cgroups import arguments as cgroup_arguments, init_command


def start(os_name, build_image=None):
    if os_name not in NATIVE_OS_NAMES:
        raise ValueError('Select a supported native Linux image')
    with vm.locked():return launch(os_name, build_image)


def launch(os_name, build_image=None):
    if os_name not in NATIVE_OS_NAMES:raise ValueError('Select a supported native Linux image')
    if build_image is not None and (os_name != 'rh8rti' or not re.fullmatch(r'localhost/mykos-building/rh8rti:[a-f0-9]{16}',build_image)):
        raise ValueError('Invalid private RH8RTI build image')
    if build_image:build_priority()
    build_args = ['-e','MYKOS_BUILD_NICE=1','--cpu-shares','128','--blkio-weight','100','--label','io.mykos.image.building=true'] if build_image else []
    args = [*build_args,*arguments(config(), os_name),*cgroup_arguments(os_name)]
    return run([PODMAN,'run','-d','-it','--hostname',os_name,'--name',os_name,
                '--rm','--privileged','--volume','/sys/fs/cgroup:/sys/fs/cgroup:ro','--memory=4g','--pull=never',*args,build_image or os_name,*init_command(os_name)])


if __name__ == '__main__':
    if len(sys.argv) not in (2,3): raise SystemExit('Usage: mykos-native-image-start OS')
    try: print(start(sys.argv[1],sys.argv[2] if len(sys.argv)==3 else None))
    except (ValueError, RuntimeError, OSError) as error: raise SystemExit(str(error))
