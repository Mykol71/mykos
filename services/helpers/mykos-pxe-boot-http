#!/usr/bin/env python3
"""Read-only HTTP handoff for UEFI. Customer jobs and credentials use HTTPS only."""
import argparse
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

FILES={'ipxe-shim.efi','ipxe.efi','snponly-shim.efi','snponly.efi','autoexec.ipxe'}


def handler(root):
    class Boot(BaseHTTPRequestHandler):
        def serve(self, body=True):
            path=urlsplit(self.path).path
            if path not in {'/'+name for name in FILES}:self.send_error(404);return
            p=root/path[1:]
            if p.is_symlink() or not p.is_file():self.send_error(404);return
            self.send_response(200);self.send_header('Content-Type','application/octet-stream');self.send_header('Content-Length',str(p.stat().st_size));self.send_header('Cache-Control','no-store');self.end_headers()
            if not body:return
            with p.open('rb') as src:
                while True:
                    data=src.read(65536)
                    if not data:break
                    self.wfile.write(data)
        def do_GET(self):self.serve()
        def do_HEAD(self):self.serve(False)
        def log_message(self,format,*args):pass
    return Boot


if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--directory',default='/home/mykos-pxe/boot');p.add_argument('--bind',default='0.0.0.0');p.add_argument('--port',type=int,default=8088);a=p.parse_args()
    ThreadingHTTPServer((a.bind,a.port),handler(Path(a.directory))).serve_forever()
