#!/usr/bin/env python3
"""Download pinned official iPXE/wimboot/curl bootstrap assets; never run them."""
import hashlib
import io
import json
from pathlib import Path
import tarfile
import urllib.request
import zipfile

ROOT=Path('/home/mykos-pxe/tools')
LOCK={
 'ipxe':('https://github.com/ipxe/ipxe/releases/download/v2.0.0/ipxeboot.tar.gz','01a526d4cc791fc30362259c609d6c506cc64a7bdff51b9a5eb788354e17eee1'),
 'wimboot':('https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot','5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3'),
 'ca':('https://curl.se/ca/cacert.pem','796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe'),
 'curl':('https://curl.se/windows/dl-8.23.0_5/curl-8.23.0_5-win64-mingw.zip','b0af3896433242213f6d1388a104115e6dfdd3b16727e5b00c2ab0f48fbc904a')}


def main():
 ROOT.mkdir(parents=True,exist_ok=True)
 results={}
 for name,(url,expected) in LOCK.items():
  with urllib.request.urlopen(url,timeout=90) as response:data=response.read(64*1024*1024)
  if hashlib.sha256(data).hexdigest()!=expected:raise ValueError('Official download digest mismatch: '+name)
  if name=='ipxe':
   with tarfile.open(fileobj=io.BytesIO(data),mode='r:gz') as t:
    for leaf in ('ipxe-shim.efi','ipxe.efi','snponly-shim.efi','snponly.efi'):
     matches=[m for m in t if (m.isfile() or m.issym() or m.islnk()) and m.name.endswith('/x86_64-sb/'+leaf)]
     if len(matches)!=1:raise ValueError('Unexpected signed iPXE archive layout')
     out=ROOT/leaf;out.write_bytes(t.extractfile(matches[0]).read());results[leaf]=hashlib.sha256(out.read_bytes()).hexdigest()
  elif name=='curl':
   with zipfile.ZipFile(io.BytesIO(data)) as z:
    for leaf in ('curl.exe',):
     matches=[n for n in z.namelist() if n.endswith('/bin/'+leaf)]
     if len(matches)!=1:raise ValueError('Unexpected curl archive layout')
     out=ROOT/leaf;out.write_bytes(z.read(matches[0]));results[leaf]=hashlib.sha256(out.read_bytes()).hexdigest()
  else:
   leaf='curl-ca-bundle.crt' if name=='ca' else 'wimboot'
   out=ROOT/leaf;out.write_bytes(data);results[leaf]=expected
 (ROOT/'SHA256.json').write_text(json.dumps(results,indent=2))
 print(json.dumps(results,indent=2))


if __name__=='__main__':main()
