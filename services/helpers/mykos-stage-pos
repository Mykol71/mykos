#!/usr/bin/env python3
"""Noninteractive rootful staging equivalent, with explicit host configuration."""
from pathlib import Path
import json
import shutil
import mykos_backup_restore as backup
import mykos_profiles as profile
import mykos_network as network
import mykos_vm as vm
import re
import socket
import sys
from mykos_runtime import PODMAN, config, containers, run, shopcode, network_device

def stage(shop, restore, image=None):
    with vm.locked():
        return _stage(shop, restore, image)


def _stage(shop, restore, image=None):
    shopcode(shop)
    if restore not in ('yes','no'): raise ValueError('Expected yes/no restore flag')
    cfg=config()
    image=image if image is not None else cfg.get('stage_image')
    if not isinstance(image,str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9./_:@-]*',image):
        raise ValueError('Configure stage_image to a locally prepared OS image')
    # Restored /etc already has its own persistent interface-ownership file.
    network_args=(network.arguments(cfg,shop+'.'+socket.gethostname()) if restore=='yes' else network.native_arguments(cfg,shop+'.'+socket.gethostname()))
    if any(x['shop']==shop for x in containers()): raise ValueError('Container already exists')
    run([PODMAN,'image','exists',image])
    vpn=Path('/usr/local/share/mykos/pos/.'+shop)
    if vpn.is_symlink(): raise ValueError('VPN directory must not be a symlink')
    vpn.mkdir(mode=0o700,parents=True,exist_ok=True)
    name=shop+'.'+socket.gethostname()
    args=[PODMAN,'run','-d','--name',name,'--hostname',name,'--privileged','--memory=2g','--pull=never','--restart=unless-stopped',
          '--volume','/sys/fs/cgroup:/sys/fs/cgroup:ro',
          '--label','io.mykos.persistent=true',
          '-v',str(vpn)+':/etc/ipsec.d:rw']
    private=None
    if restore=='yes':
        args[1:3]=['create']
        args.append('--no-hosts')
        args.extend(profile.mounts(shop,cfg))
        private,private_args=backup.private_mounts(vpn)
        args.extend(private_args)
    args.extend(network_args)
    args.extend([image,'/sbin/init'])
    cid=None
    try:
        cid=run(args)
        if restore=='yes':
            prepare_backup(cid,name,shop,cfg,network_args,private)
            run([PODMAN,'start',cid])
        if any(vpn.glob('*.conn.conf')):
            run([PODMAN,'exec',cid,'systemctl','restart','ipsec'])
        if restore=='yes':
            for service in profile.services():
                run([PODMAN,'exec',cid,'systemctl','restart',service])
        Path('/usr/local/share/mykos/pos/.'+shop+'.container').write_text(cid+'\n')
        return 'Container '+name+' ready; verify OS and configured VPN health'
    except Exception:
        # Only remove the container created by this attempt; retain customer backup/VPN data.
        if cid:run([PODMAN,'rm','--force',cid])
        if private:shutil.rmtree(private)
        raise

def prepare_backup(cid,name,shop,cfg,network_args,private=None):
    """Prepare only this new stopped container's root; binds attach at start."""
    value=json.loads(run([PODMAN,'inspect',cid]))[0]
    if value.get('Id')!=cid or value.get('Name','').lstrip('/')!=name or value.get('State',{}).get('Running'):
        raise ValueError('Backup preparation requires the newly created stopped container')
    root=None
    try:
        root=run([PODMAN,'mount',cid])
        mounted=json.loads(run([PODMAN,'mount','--format','json']))
        matching=[item for item in mounted if item.get('id')==cid]
        if len(matching)!=1 or not matching[0].get('mountpoint') or Path(root).resolve()!=Path(matching[0]['mountpoint']).resolve():
            raise ValueError('Mounted root does not belong to the created container')
        if any(Path(root)==Path(item['Source']) or Path(item['Source']).resolve() in Path(root).resolve().parents
               for item in value.get('Mounts',[]) if item.get('Type')=='bind'):
            raise ValueError('Container root overlaps a host bind source')
        address=network_args[network_args.index('--ip')+1] if '--ip' in network_args else None
        backup.prepare(shop,cfg,root,name,address)
        if private:backup.export_private(root,private)
    finally:
        if root:run([PODMAN,'unmount',cid])


if __name__=='__main__':
    if len(sys.argv) not in (3,4): raise SystemExit('Usage: mykos-stage-pos SHOP yes|no [IMAGE]')
    try: print(stage(sys.argv[1],sys.argv[2],sys.argv[3] if len(sys.argv)==4 else None))
    except Exception as e: raise SystemExit(str(e))
