[Unit]
Description=MYKOS unattended image build for %i
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=10
IOWeight=10
OOMScoreAdjust=500
ExecStart=@PYTHON@ /usr/local/sbin/mykos-image-build %i --worker
UMask=0077
TimeoutStartSec=4h
TimeoutStopSec=20s
KillMode=control-group
