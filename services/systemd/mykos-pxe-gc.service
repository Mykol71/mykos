[Unit]
Description=Expire MYKOS PXE staging leases
ConditionPathExists=/opt/mykos-web/data/pxe/jobs.db
[Service]
Type=oneshot
User=mykosweb
Group=mykosweb
WorkingDirectory=/opt/mykos-web
ExecStart=/opt/mykos-web/.venv/bin/python -c "import pxe_store; pxe_store.expire()"
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/mykos-web/data/pxe
ProtectHome=true
PrivateTmp=true
