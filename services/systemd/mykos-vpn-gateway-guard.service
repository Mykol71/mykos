[Unit]
Description=Protect saved MYKOS VPN guest routes before automatic guest startup
Wants=network-online.target
After=network-online.target firewalld.service
Before=podman-restart.service

[Service]
Type=oneshot
ExecStart=@PYTHON@ /usr/local/sbin/mykos-vpn-gateway guard
UMask=0077
TimeoutStartSec=60s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
RequiredBy=podman-restart.service
